# ETS release publisher (1.12.19, PHASE 2) — the privileged TEST-side helper of Settings → «الترقية والنشر». The web
# application runs as the unprivileged user ets and never gets root or a git push credential: it records a SIGNED
# promotion intent in the database (backend/src/routes/release.js); this oneshot service (root) re-reads it, re-verifies
# the signature against the allow-listed signers, creates/pushes the annotated signed tag v<version>, pushes the signed
# manifest deploy/production-release.json via the write-restricted deploy key, and pulls the signed status back.
# Started every 60 s by ets-release-publisher.timer and at once by ets-release-publisher.path (the API touches
# /var/lib/ets/inbox/.release-wake). Mirrors ets-backup-agent.service.
[Unit]
Description=ETS release publisher (sign + push the production promotion signal)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=ETS_ENV_FILE=/etc/ets/ets.env
WorkingDirectory=/opt/ets/backend
ExecStart=/usr/local/sbin/ets-release-publisher run
StandardOutput=append:/var/log/ets-release-publisher.log
StandardError=append:/var/log/ets-release-publisher.log
TimeoutStartSec=30min
UMask=0077

# Hardening — finding I1, defense-in-depth (check with: systemd-analyze security ets-release-publisher).
# This agent only runs git / ssh / node (verify.mjs) — no setuid helper and no sudo — so NoNewPrivileges is safe
# here (unlike the deploy and backup agents, which exec sudo). PrivateTmp is safe too: the only /tmp use is the
# verifier's own temp dir (src/release/publisher.js verifyWithHelper → os.tmpdir()), read by a child in the same
# namespace; nothing outside the service shares those files.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
# Deliberately NOT added (would risk breaking the push — untestable in the dev sandbox):
#   - ProtectSystem=strict / ReadWritePaths: the git working copy (conf.REPO_DIR, operator-configured) and its whole
#     .git tree must be writable for fetch/checkout/reset/stash/commit, and REPO_DIR is not known to this unit, so a
#     precise ReadWritePaths cannot be written safely.
#   - ProtectHome: git reads /root/.gitconfig (safe.directory) and ssh writes /root/.ssh/known_hosts (accept-new).
#   - MemoryDenyWriteExecute: breaks the V8 / Node JIT (same reason as ets-backend).
