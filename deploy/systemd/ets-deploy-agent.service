# ETS deploy agent (1.12.19, PHASE 2) — the privileged PRODUCTION-side helper. Installed BY THE OPERATOR on the
# production server (not by the test install). It PULLS the signed signal from git and VERIFIES it cryptographically
# (all §3.1 checks, including git merge-base --is-ancestor) before taking a pre-deploy backup, checking out the tagged
# commit, running deploy/scripts/update.sh (migrations + build + restart), health-gating, and writing/signing/pushing
# the status back. It must run update.sh (which restarts ets-backend and runs the PostgreSQL superuser migration
# step), so it is intentionally NOT filesystem-sandboxed — matching ets-backup-agent.service. Started every 30 s by
# ets-deploy-agent.timer and at once by ets-deploy-agent.path. Configure it in /etc/ets/deploy-agent.conf.
[Unit]
Description=ETS deploy agent (pull + verify + deploy the promoted release on production)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=ETS_ENV_FILE=/etc/ets/ets.env
WorkingDirectory=/opt/ets/backend
ExecStart=/usr/local/sbin/ets-deploy-agent run
StandardOutput=append:/var/log/ets-deploy-agent.log
StandardError=append:/var/log/ets-deploy-agent.log
# a deploy (build + migrations + health gate, and possibly a code rollback) can take a while
TimeoutStartSec=6h
UMask=0077

# Hardening — finding I1, defense-in-depth (check with: systemd-analyze security ets-deploy-agent).
# ONLY the kernel / privilege-escalation / namespace set here: this agent must write /opt/ets and run update.sh
# (build + migrations + service restarts), so NO filesystem confinement is added (ProtectSystem=strict and friends
# would break the deploy — as the unit header already notes).
# Deliberately NOT added (would break the deploy — untestable in the dev sandbox):
#   - NoNewPrivileges: update.sh → deploy-lib.sh builds as `sudo -u $BUILD_USER` (deploy/scripts/deploy-lib.sh:94)
#     and migrates as `sudo -u ets` / `sudo -u postgres` via ets-log-protect (deploy-lib.sh:291, log-protect.sh:45);
#     no_new_privs makes sudo refuse. (The agent does not rely on any setuid helper for escalation otherwise.)
#   - ProtectSystem=strict / ReadWritePaths / ProtectHome / PrivateTmp: update.sh writes /opt/ets, apt-get installs
#     rclone, npm builds in the build user's home and git rewrites the working copy — host FS and /tmp are required.
#   - MemoryDenyWriteExecute: breaks the V8 / Node JIT (same reason as ets-backend).
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
