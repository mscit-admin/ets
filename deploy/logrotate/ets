/var/log/ets/*.log {
    daily
    rotate 90
    missingok
    notifempty
    compress
    delaycompress
    dateext
    copytruncate
    su ets ets
    create 0640 ets ets
}

# backup output (written by root's systemd services, kept outside the ets-writable /var/log/ets): backups,
# offsite copies, weekly test restore, backup agent (1.12.0)
/var/log/ets-backup.log /var/log/ets-offsite.log /var/log/ets-backup-verify.log /var/log/ets-backup-agent.log {
    monthly
    rotate 12
    missingok
    notifempty
    compress
    delaycompress
    dateext
    create 0600 root root
}
