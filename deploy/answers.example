# ETS — answers file for an unattended installation.
#   cp deploy/answers.example /root/ets-answers && nano /root/ets-answers
#   sudo bash deploy/install.sh --answers /root/ets-answers --yes
#   shred -u /root/ets-answers        # it contains passwords — delete it afterwards
# Any variable left out (or commented) is asked interactively unless --yes is used.

ETS_ADDRESS=ets.company.ly          # domain name or IP address users will open
ETS_TLS=selfsigned                  # selfsigned | letsencrypt (domain only) | existing | none
ETS_HTTPS_PORT=443                  # port users open (HTTPS)
ETS_HTTP_PORT=80                    # HTTP port: redirects to HTTPS (0 = none); the web port itself when ETS_TLS=none
ETS_API_PORT=3000                   # internal application port (localhost only)
#ETS_LE_EMAIL=it@company.ly         # letsencrypt only
#ETS_CERT=/etc/ssl/company/ets.crt  # existing only
#ETS_KEY=/etc/ssl/company/ets.key   # existing only

ETS_DB_MODE=local                   # local (create on this server) | remote (existing PostgreSQL server)
#ETS_DB_HOST=10.0.0.20              # remote only
ETS_DB_PORT=5432
ETS_DB_NAME=ets
ETS_DB_USER=ets
ETS_DB_PASSWORD=ChangeMe-DbPass-2026   # 12+ chars, no spaces/quotes/backslash/$/#; empty = generate (local)

ETS_ADMIN_USER=admin
ETS_ADMIN_NAME="System Administrator"
ETS_ADMIN_EMAIL=
ETS_ADMIN_PASSWORD=ChangeMe-Admin2026   # 10+ chars, letters and digits, not containing the username

ETS_MFA_MODE=optional               # off | optional | required
ETS_ORG_NAME_AR="مركز متابعة إنجاز ERP"
ETS_ORG_NAME_EN="ERP Implementation Tracking Center"
ETS_TIMEZONE=Africa/Tripoli
ETS_BACKUP_KEEP_DAYS=30
ETS_IMPORT_FILE=                    # path of the original tracker HTML/JSON to import, or empty
ETS_FIREWALL=yes                    # yes | no
