# ETS — nginx site (plain HTTP, no certificate). Generated by deploy/install.sh.
# Use only on a trusted internal network; passwords travel unencrypted.
# Placeholders: __SERVER_NAME__ __HTTP_PORT__ __API_PORT__

limit_req_zone $binary_remote_addr zone=ets_login:10m rate=10r/m;

server {
    listen __HTTP_PORT__;
    listen [::]:__HTTP_PORT__;
    server_name __SERVER_NAME__;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    include /etc/nginx/snippets/ets-app.conf;
}
