# ETS — nginx site (HTTPS). Generated by deploy/install.sh into /etc/nginx/sites-available/ets.
# Placeholders: __SERVER_NAME__ __HTTPS_PORT__ __API_PORT__ __SSL_CERT__ __SSL_KEY__

limit_req_zone $binary_remote_addr zone=ets_login:10m rate=10r/m;

server {
    # "ssl http2" on the listen line works on Ubuntu 22.04 (nginx 1.18) and 24.04 (nginx 1.24)
    listen __HTTPS_PORT__ ssl http2;
    listen [::]:__HTTPS_PORT__ ssl http2;
    server_name __SERVER_NAME__;

    ssl_certificate     __SSL_CERT__;
    ssl_certificate_key __SSL_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    # HTTP sent to the HTTPS port → redirect to https on the same port
    error_page 497 =301 https://$host:$server_port$request_uri;

    include /etc/nginx/snippets/ets-app.conf;
}
