{
  "name": "ets-backend",
  "version": "0.5.2",
  "private": true,
  "description": "ETS — ERP Tracking System: REST API (Node.js + Express + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "node src/db/migrate.js && node src/db/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "import-legacy": "node scripts/import-legacy.js",
    "purge-logs": "node scripts/purge-logs.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4"
  }
}
