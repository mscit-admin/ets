# ETS backend configuration. On the server this file lives at /etc/ets/ets.env
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# REQUIRED. Generate with:  openssl rand -base64 48   (placeholders and short values are refused at start)
# It encrypts users' 2FA secrets: to change it later, see APP_SECRET rotation in docs/handover/06-Security.md.
APP_SECRET=
# Only while rotating APP_SECRET: the previous value(s), then run: npm run rotate-app-secret
#APP_SECRET_OLD=

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ets
PGUSER=ets
PGPASSWORD=
PGPOOL_MAX=10
# TLS to PostgreSQL (libpq names): disable | require | verify-ca | verify-full. Empty: none for a local
# server, "require" for any other host (a remote server without TLS is refused).
PGSSLMODE=
# CA certificate of the database server, for verify-ca / verify-full
PGSSLROOTCERT=
# Optional client certificate / key for the database connection
#PGSSLCERT=
#PGSSLKEY=

# Sessions
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# true: the session cookie is "__Host-ets_sid" (Secure, HTTPS only) — always true on a server (HTTPS only).
# false only for local development over plain http (cookie "ets_sid"); with NODE_ENV=production it is refused
# at start unless ALLOW_INSECURE_COOKIES=true (lab only, never on a real server).
COOKIE_SECURE=true
#ALLOW_INSECURE_COOKIES=false
# cookie base name (the __Host- prefix is added when COOKIE_SECURE=true)
#SESSION_COOKIE=ets_sid

# Login protection: from MAX_FAILED_LOGINS failures sign-in to the account pauses 1, 2, 4 … minutes
# (at most LOCK_MINUTES); the count restarts after LOCKOUT_RESET_MINUTES without failures.
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
LOCKOUT_RESET_MINUTES=60
# password / 2FA checks per IP per 15 min; any API request per IP per minute
LOGIN_RATE_LIMIT=30
API_RATE_LIMIT=600
# 10–14
BCRYPT_ROUNDS=12
# who may tell the API the client IP (X-Forwarded-For): nginx on the same server. Never "true".
# Behind a load balancer configure nginx real_ip instead (docs/handover/02-Installation-Guide.md §9).
TRUST_PROXY=loopback

# Logs (JSON lines, rotated by /etc/logrotate.d/ets)
LOG_DIR=/var/log/ets
LOG_LEVEL=info
ACCESS_LOG_DB=true

# Live updates of the screens (GET /api/events): heartbeat (the session is re-checked on each one, seconds)
# and open streams per user (one per browser tab)
#LIVE_HEARTBEAT_SECONDS=25
#LIVE_MAX_STREAMS_PER_USER=5

# Online users (1.11.0): at most one presence write per session in this many seconds (later reports are coalesced)
#PRESENCE_MIN_INTERVAL_SECONDS=10

# Phones (Android app, 1.9.0) — written into the pairing QR code; deploy/install.sh and update.sh fill both from the
# nginx address and certificate. PUBLIC_BASE_URL: the address the phones use (inside the network, or over the VPN);
# empty → the address of the browser asking for the code. TLS_CERT_SHA256: SHA-256 of the server certificate (DER),
# 64 hex digits (colons allowed): openssl x509 -in <cert> -noout -fingerprint -sha256 ; empty → null (public CA).
# PAIR_RATE_LIMIT: pairing attempts per IP per 15 minutes.
#PUBLIC_BASE_URL=https://ets.example.ly
#TLS_CERT_SHA256=
#PAIR_RATE_LIMIT=5

# Optional: let Node serve the built frontend (normally nginx does this)
STATIC_DIR=

# Backups (read by ets-backup / ets-restore; written by the installer)
#ETS_BACKUP_DIR=/var/backups/ets
#ETS_BACKUP_KEEP_DAYS=30
#ETS_BACKUP_KEY=/etc/ets/backup.key
