# ETS backend configuration. On the server this file lives at /etc/ets/ets.env
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Generate with:  openssl rand -base64 48
# NEVER change after go-live: it encrypts users' 2FA secrets.
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ets
PGUSER=ets
PGPASSWORD=change-me
PGPOOL_MAX=10

# Sessions
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# true when the site is served over HTTPS (recommended); false for plain HTTP
COOKIE_SECURE=true

# Login protection: from MAX_FAILED_LOGINS failures sign-in to the account pauses 1, 2, 4 … minutes
# (at most LOCK_MINUTES); the count restarts after LOCKOUT_RESET_MINUTES without failures.
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
LOCKOUT_RESET_MINUTES=60
# password / 2FA checks per IP per 15 min; any API request per IP per minute
LOGIN_RATE_LIMIT=30
API_RATE_LIMIT=600
# 10–14
BCRYPT_ROUNDS=12
# nginx runs on the same server
TRUST_PROXY=loopback

# Logs (JSON lines, rotated by /etc/logrotate.d/ets)
LOG_DIR=/var/log/ets
LOG_LEVEL=info
ACCESS_LOG_DB=true

# Optional: let Node serve the built frontend (normally nginx does this)
STATIC_DIR=
